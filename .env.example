# GCD-ARCADE BFF environment. Copy to apps/bff/.env for local dev (the BFF
# reads process.env). On Render these are set per the render.yaml service.

# --- backend base URLs (where each app serves /console/*) ---
# GCD-SOCIAL API (reference implementation of the /console contract):
GCD_SOCIAL_URL=https://gcd-social-api.onrender.com
# gcd-webhook: same host serves /console/*, /admin/sms and /api/admin/transcripts:
GCD_WEBHOOK_URL=https://gcd-webhook.onrender.com
# Attribution: the Fastify API service host (NOT the Next.js web host
# gcd-attribution-web.onrender.com, which is the "Open full dashboard" link-out):
ATTRIBUTION_URL=https://gcd-attribution-api.onrender.com
# GCD QBO Hub: the Next.js host that serves /console/* (route handlers ship
# inside the gcd-qbo-hub repo itself, not in integrations/):
GCD_QBO_HUB_URL=https://gcd-qbo-hub.onrender.com

# --- optional per-app console tokens (server-side only; never sent to client) ---
GCD_SOCIAL_CONSOLE_TOKEN=
ATTRIBUTION_CONSOLE_TOKEN=
GCD_WEBHOOK_CONSOLE_TOKEN=
GCD_QBO_HUB_CONSOLE_TOKEN=

# --- optional: admin secret for gcd-webhook link-out UIs (?secret=) ---
GCD_WEBHOOK_ADMIN_SECRET=

# --- optional: bearer secret for gcd-qbo-hub's Arcade bridge routes
# (/api/external/*, e.g. Financial Projections reporting + the shared AI
# Report Assistant conversation) — sent as `Authorization: Bearer`, matching
# that repo's ARCADE_BRIDGE_SECRET ---
GCD_QBO_HUB_BRIDGE_SECRET=

# --- optional toggles ---
# GCD_SOCIAL_ENABLED=true
# ATTRIBUTION_ENABLED=true
# GCD_WEBHOOK_ENABLED=true
# GCD_QBO_HUB_ENABLED=true
# PORT=8787
# MANIFEST_TTL_MS=60000
