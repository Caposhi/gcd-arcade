# GCD Arcade web/BFF environment. For local development, copy this to the
# ignored .env.local and export it into the shell; the BFF reads process.env
# and does not load env files itself. Render injects service variables.
#
# Safe local template. Outbound integrations are disabled by default. Replace
# example.invalid only in a private environment and enable one service at a time.

# --- browser and Vite development routing ---
VITE_BFF_URL=
BFF_PROXY_TARGET=http://localhost:8787

# --- backend base URLs (where each app serves /console/*) ---
GCD_SOCIAL_URL=https://gcd-social.example.invalid
GCD_WEBHOOK_URL=https://gcd-webhook.example.invalid
ATTRIBUTION_URL=https://attribution-api.example.invalid
GCD_QBO_HUB_URL=https://gcd-qbo-hub.example.invalid

# --- optional per-app console tokens (server-side only; never sent to client) ---
GCD_SOCIAL_CONSOLE_TOKEN=
ATTRIBUTION_CONSOLE_TOKEN=
GCD_WEBHOOK_CONSOLE_TOKEN=
GCD_QBO_HUB_CONSOLE_TOKEN=

# --- optional: admin secret for gcd-webhook link-out UIs (?secret=) ---
GCD_WEBHOOK_ADMIN_SECRET=

# --- optional: bearer secret for gcd-qbo-hub's Arcade bridge routes
# (/api/external/*, e.g. Financial Projections reporting + the shared AI
# Report Assistant conversation) — sent as `Authorization: Bearer`, matching
# that repo's ARCADE_BRIDGE_SECRET ---
GCD_QBO_HUB_BRIDGE_SECRET=

# --- enablement (false is the safe local default) ---
GCD_SOCIAL_ENABLED=false
ATTRIBUTION_ENABLED=false
GCD_WEBHOOK_ENABLED=false
GCD_QBO_HUB_ENABLED=false

# --- BFF runtime ---
PORT=8787
MANIFEST_TTL_MS=60000
